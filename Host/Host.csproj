<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net7.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>WordCraft.Host</RootNamespace>
    <AssemblyName>WordCraft.Host</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Net/Net.csproj" />
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <!--
    The client's scenario, compiled here as well as by Unity and by Replay, and
    free of UnityEngine for the same reason. A solo run has to be the map a
    player actually plays, or it verifies an opponent nobody will ever meet.
  -->
  <ItemGroup>
    <Compile Include="../Client/Assets/Scripts/MatchScenario.cs" />
  </ItemGroup>

</Project>
