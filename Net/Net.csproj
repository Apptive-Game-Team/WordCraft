<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1, same as Sim, so this assembly drops into Unity 2022. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>WordCraft.Net</RootNamespace>
    <AssemblyName>WordCraft.Net</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <!-- Same one-way vendoring as Sim. See Sim.csproj for why it runs every build. -->
  <Target Name="VendorToClient" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)../Client/Assets/Plugins')">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildThisFileDirectory)../Client/Assets/Plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
