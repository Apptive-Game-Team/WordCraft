<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 so this assembly drops into Unity 2022 unchanged. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>WordCraft.Sim</RootNamespace>
    <AssemblyName>WordCraft.Sim</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    The Unity client consumes this as a compiled assembly, copied one way, which
    is what keeps UnityEngine off this project's compile path. Copying on every
    build is what stops the committed copy from drifting behind the source the
    headless checks actually run against.
  -->
  <Target Name="VendorToClient" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)../Client/Assets/Plugins')">
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(MSBuildThisFileDirectory)../Client/Assets/Plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
