<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>WordCraft.Replay</RootNamespace>
    <AssemblyName>WordCraft.Replay</AssemblyName>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

  <!--
    The client's scenario and input log, compiled here as well as by Unity. Both
    files are free of UnityEngine on purpose: running the identical log under
    CoreCLR and under Unity's Mono and comparing the hash is what catches a
    runtime difference before it becomes a desync between two players' machines.
  -->
  <ItemGroup>
    <Compile Include="../Client/Assets/Scripts/MatchScenario.cs" />
    <Compile Include="../Client/Assets/Editor/ScriptedLog.cs" />
    <Compile Include="../Client/Assets/Scripts/HitDetection.cs" />
    <Compile Include="../Client/Assets/Scripts/AlertWindow.cs" />
    <Compile Include="../Client/Assets/Scripts/ProductionMenu.cs" />
  </ItemGroup>

</Project>
